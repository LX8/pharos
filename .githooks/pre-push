#
# Free, local CI — runs the deterministic offline gate (recompute the indicators
# from the pinned snapshots with NO network, drift-check, tests, ledger + honesty
# audits) before each push. No cloud, no billing.
# Install once with:  make hooks
# Bypass once with:    git push --no-verify
cd "$(git rev-parse --show-toplevel)" || exit 1
echo "[pre-push] make verify-offline"
exec make verify-offline
